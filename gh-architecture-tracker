#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
DIST_DIR="${SCRIPT_DIR}/dist"
VERSION=$(cat "${SCRIPT_DIR}/VERSION" 2>/dev/null || echo "dev")
VERSION_MARKER=".architecture-tracker-version"
# 前回の init / update で配布していた Agent Skill の本文のハッシュ（配置したかどうかに関係なく記録する）。
# update で「Agent Skill をまだ案内していない」「配布版が更新された」を判定するために使う
SKILL_RECORD=".architecture-tracker-skill-hash"
APP_SLUG="architecture-tracker-cv"
APP_INSTALL_URL="https://github.com/apps/${APP_SLUG}/installations/new"

# --- Colors ---

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
NC='\033[0m'

info()  { echo -e "${CYAN}ℹ${NC} $*"; }
ok()    { echo -e "${GREEN}✅${NC} $*"; }
warn()  { echo -e "${YELLOW}⚠${NC} $*"; }
error() { echo -e "${RED}✖${NC} $*" >&2; }

# --- Helpers ---

require_git_repo() {
  if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    error "Gitリポジトリ内で実行してください。"
    exit 1
  fi
}

require_default_branch() {
  local current_branch
  current_branch=$(git branch --show-current)
  if [ -z "$current_branch" ]; then
    error "detached HEAD 状態です。デフォルトブランチをチェックアウトしてください。"
    exit 1
  fi
  local default_branch
  default_branch=$(git symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||' || echo "main")
  if [ "$current_branch" != "$default_branch" ]; then
    error "デフォルトブランチ（${default_branch}）で実行してください。現在のブランチ: ${current_branch}"
    exit 1
  fi
}

require_dist() {
  if [ ! -d "$DIST_DIR" ]; then
    error "配布ファイルが見つかりません: ${DIST_DIR}"
    error "gh extension を再インストールしてください: gh extension install kenkenji/gh-architecture-tracker"
    exit 1
  fi
}

get_repo_root() {
  git rev-parse --show-toplevel
}

require_app_installed() {
  echo ""
  info "GitHub App「Architecture Tracker」のインストールが必要です。"
  echo "  インストールページ: ${APP_INSTALL_URL}"
  echo ""
  if ! confirm "GitHub App をインストール済みですか？"; then
    info "上記URLからインストール後、再度実行してください。"
    exit 1
  fi
}

get_repo_nwo() {
  git remote get-url origin 2>/dev/null | sed -E 's|.*github\.com[:/]||; s|\.git$||'
}

get_repo_name() {
  git remote get-url origin 2>/dev/null | sed 's|.*/||;s|\.git$||' || \
    basename "$(get_repo_root)"
}

# データブランチを取得する先の ref。FETCH_HEAD は他の fetch で上書きされるため、名前付きの ref に取得する
DATA_REF="refs/remotes/origin/_architecture-tracker"

# 取得済みのデータブランチ（DATA_REF）にあるファイルの内容（なければ空）。
# Git Bash（MSYS）は "/" と ":" を含む引数（refs/...:file）をパスのリストとみなして変換するため、
# ref をコミットの SHA に解決してから "<sha>:<file>" で読む
read_data_file() {
  local commit
  commit=$(git rev-parse --verify -q "${DATA_REF}^{commit}" 2>/dev/null) || return 0
  git show "${commit}:$1" 2>/dev/null || true
}

get_installed_version() {
  if git fetch origin "+_architecture-tracker:${DATA_REF}" 2>/dev/null; then
    read_data_file "${VERSION_MARKER}"
  else
    echo ""
  fi
}

# データブランチに記録された Agent Skill のハッシュ（なければ空）。
# get_installed_version が取得した DATA_REF を読む
get_recorded_skill_hash() {
  read_data_file "${SKILL_RECORD}" | tr -d '[:space:]'
}

confirm() {
  local prompt="$1"
  echo -en "${prompt} [Y/n] "
  read -r answer
  case "$answer" in
    [nN]*) return 1 ;;
    *) return 0 ;;
  esac
}

sed_inplace() {
  if [[ "$(uname)" == "Darwin" ]]; then
    sed -i '' "$@"
  else
    sed -i "$@"
  fi
}

version_gt() {
  local v1="$1" v2="$2"
  local IFS='.'
  read -ra parts1 <<< "$v1"
  read -ra parts2 <<< "$v2"
  local max=$(( ${#parts1[@]} > ${#parts2[@]} ? ${#parts1[@]} : ${#parts2[@]} ))
  for (( i=0; i<max; i++ )); do
    local n1=${parts1[$i]:-0}
    local n2=${parts2[$i]:-0}
    if (( n1 > n2 )); then return 0; fi
    if (( n1 < n2 )); then return 1; fi
  done
  return 1
}

check_latest_version() {
  if [ "$VERSION" = "dev" ]; then return 0; fi
  local remote_version
  remote_version=$(gh api "repos/kenkenji/gh-architecture-tracker/contents/VERSION" \
    --jq '.content' 2>/dev/null) || return 0
  if [ -z "$remote_version" ]; then return 0; fi
  local decoded
  decoded=$(echo "$remote_version" | base64 -d 2>/dev/null) || decoded=$(echo "$remote_version" | base64 --decode 2>/dev/null) || return 0
  remote_version=$(echo "$decoded" | tr -d '[:space:]')
  if [ -z "$remote_version" ]; then return 0; fi
  if version_gt "$remote_version" "$VERSION"; then
    echo ""
    warn "gh extension のバージョンが古くなっています"
    echo "  ローカル: v${VERSION}"
    echo "  最新:     v${remote_version}"
    echo ""
    info "以下のコマンドで更新できます:"
    echo "  gh extension upgrade architecture-tracker"
    echo ""
  fi
}

create_data_branch() {
  local remote_url
  remote_url=$(git remote get-url origin)

  if git ls-remote --heads "$remote_url" _architecture-tracker 2>/dev/null | grep -q '_architecture-tracker'; then
    ok "_architecture-tracker ブランチは既に存在します"
    return 0
  fi

  info "_architecture-tracker データブランチを作成しています..."

  local work_dir
  work_dir=$(mktemp -d)
  # RETURN トラップは関数を抜けても残り、呼び出し元の終了時にも実行される（work_dir は未定義）ため、1回で解除する
  trap 'rm -rf "$work_dir"; trap - RETURN' RETURN

  git init "$work_dir" >/dev/null 2>&1
  git -C "$work_dir" checkout --orphan _architecture-tracker >/dev/null 2>&1
  git -C "$work_dir" remote add origin "$remote_url" 2>/dev/null
  git -C "$work_dir" config user.name "$(git config user.name || echo 'gh-extension')"
  git -C "$work_dir" config user.email "$(git config user.email || echo 'gh-extension@users.noreply.github.com')"

  # 初期データファイルを作成
  cat > "${work_dir}/components.yaml" << 'YAML'
# Architecture Tracker — コンポーネント定義
# SPA上のエディタで編集できます
schema_version: "1"
version: "1"
model:
  type: "c4"
components: []
relations: []
YAML

  local owner repo_name
  owner=$(get_repo_nwo | cut -d/ -f1)
  repo_name=$(get_repo_name)
  cat > "${work_dir}/config.yaml" << YAML
spa:
  url: https://${owner}.github.io/${repo_name}
llm:
  model: claude-sonnet-5
auto_approve: false
YAML

  echo '{"version":"1.0","mappings":{}}' > "${work_dir}/mappings.json"
  echo '{"version":"1.0","entries":[]}' > "${work_dir}/timeline.json"
  echo '{"version":"1.0","entries":[]}' > "${work_dir}/model-changelog.json"
  echo "$VERSION" > "${work_dir}/${VERSION_MARKER}"
  local skill_hash
  skill_hash=$(distributed_skill_hash)
  if [ -n "$skill_hash" ]; then
    echo "$skill_hash" > "${work_dir}/${SKILL_RECORD}"
  fi

  git -C "$work_dir" add -A
  git -C "$work_dir" commit -m "Initialize architecture tracker data" >/dev/null

  if git -C "$work_dir" push origin _architecture-tracker; then
    ok "_architecture-tracker ブランチを作成しました"
  else
    warn "_architecture-tracker ブランチの作成に失敗しました"
    return 1
  fi
}

# バージョンマーカーと、配布した Agent Skill のハッシュ（skill_hash が空なら記録を変えない）を書き込む
write_version_to_data_branch() {
  local version="$1" skill_hash="${2:-}"
  local remote_url
  remote_url=$(git remote get-url origin)

  info "バージョン情報を _architecture-tracker ブランチに書き込んでいます..."

  local work_dir
  work_dir=$(mktemp -d)
  # RETURN トラップは関数を抜けても残り、呼び出し元の終了時にも実行される（work_dir は未定義）ため、1回で解除する
  trap 'rm -rf "$work_dir"; trap - RETURN' RETURN

  git clone --branch _architecture-tracker --single-branch --depth 1 "$remote_url" "$work_dir" >/dev/null 2>&1 || {
    warn "_architecture-tracker ブランチのcloneに失敗しました。"
    return 1
  }

  echo "$version" > "${work_dir}/${VERSION_MARKER}"
  if [ -n "$skill_hash" ]; then
    echo "$skill_hash" > "${work_dir}/${SKILL_RECORD}"
  fi

  git -C "$work_dir" config user.name "$(git config user.name || echo 'gh-extension')"
  git -C "$work_dir" config user.email "$(git config user.email || echo 'gh-extension@users.noreply.github.com')"
  git -C "$work_dir" add "${VERSION_MARKER}"
  if [ -n "$skill_hash" ]; then
    git -C "$work_dir" add "${SKILL_RECORD}"
  fi

  if git -C "$work_dir" diff --cached --quiet 2>/dev/null; then
    ok "バージョン情報に変更はありません"
    return 0
  fi

  # 変わったものだけを表示・コミットメッセージに書く（Agent Skill の記録だけが変わる場合がある）
  local changed_text subject_text
  if git -C "$work_dir" diff --cached --quiet -- "${SKILL_RECORD}" 2>/dev/null; then
    changed_text="バージョンマーカー (v${version})"
    subject_text="version marker to v${version}"
  elif git -C "$work_dir" diff --cached --quiet -- "${VERSION_MARKER}" 2>/dev/null; then
    changed_text="Agent Skill の記録"
    subject_text="Agent Skill record"
  else
    changed_text="バージョンマーカー (v${version}) と Agent Skill の記録"
    subject_text="version marker to v${version} and Agent Skill record"
  fi

  git -C "$work_dir" commit -m "Update ${subject_text}" >/dev/null
  if git -C "$work_dir" push origin _architecture-tracker; then
    ok "${changed_text}を更新しました"
  else
    warn "${changed_text}の更新に失敗しました"
    return 1
  fi
}

configure_branch_protection() {
  local repo="$1"

  info "ブランチ保護を設定しています..."

  local tmpfile
  tmpfile=$(mktemp) || { warn "一時ファイルの作成に失敗しました"; return 1; }
  printf '%s\n' '{"required_status_checks":null,"enforce_admins":false,"required_pull_request_reviews":null,"restrictions":null,"allow_force_pushes":false,"allow_deletions":false}' > "$tmpfile"
  if gh api "repos/${repo}/branches/_architecture-tracker/protection" \
    -X PUT --input "$tmpfile" --silent 2>/dev/null; then
    ok "ブランチ保護を設定しました"
  else
    warn "ブランチ保護の設定に失敗しました（権限不足の可能性があります）"
  fi
  rm -f "$tmpfile"
}

enable_github_pages() {
  local repo="$1"

  # GitHub Pagesの現在の設定を確認
  local pages_status
  pages_status=$(gh api "repos/${repo}/pages" --jq '.status' 2>/dev/null || echo "not_found")

  if [ "$pages_status" != "not_found" ]; then
    ok "GitHub Pages は既に設定済みです (status: ${pages_status})"
    # ソースブランチがgh-pagesでない場合は更新
    local current_branch
    current_branch=$(gh api "repos/${repo}/pages" --jq '.source.branch' 2>/dev/null || echo "")
    if [ "$current_branch" != "gh-pages" ]; then
      info "Pages ソースを gh-pages ブランチに更新しています..."
      gh api "repos/${repo}/pages" \
        -X PUT \
        -f "source[branch]=gh-pages" \
        -f "source[path]=/" \
        --silent 2>/dev/null || true
    fi
    return 0
  fi

  # GitHub Pagesを有効化
  info "GitHub Pages を有効化しています..."
  if gh api "repos/${repo}/pages" \
    -X POST \
    -f "source[branch]=gh-pages" \
    -f "source[path]=/" \
    --silent 2>/dev/null; then
    ok "GitHub Pages を有効化しました"
  else
    warn "GitHub Pagesの自動有効化に失敗しました"
    echo ""
    echo "以下の手順で手動設定してください："
    echo "  1. リポジトリの Settings → Pages を開く"
    echo "  2. Source を 'Deploy from a branch' に設定"
    echo "  3. Branch を 'gh-pages' / '/ (root)' に設定"
    echo "  4. Save をクリック"
  fi
}

deploy_spa_to_ghpages() {
  local root="$1"
  local repo_name="$2"
  local spa_dist="${DIST_DIR}/spa-dist"

  if [ ! -d "$spa_dist" ]; then
    warn "プリビルド済みSPAが見つかりません。gh extension を再インストールしてください。"
    return 1
  fi

  info "SPA を gh-pages ブランチにデプロイしています..."

  local work_dir
  work_dir=$(mktemp -d)

  local remote_url
  remote_url=$(git -C "$root" remote get-url origin)

  if git ls-remote --heads "$remote_url" gh-pages 2>/dev/null | grep -q 'refs/heads/gh-pages$'; then
    git clone --branch gh-pages --single-branch "$remote_url" "$work_dir" || {
      warn "gh-pagesブランチのcloneに失敗しました。"
      rm -rf "$work_dir"
      return 1
    }
  else
    git init "$work_dir" >/dev/null 2>&1
    git -C "$work_dir" checkout --orphan gh-pages >/dev/null 2>&1
    git -C "$work_dir" remote add origin "$remote_url" 2>/dev/null
  fi

  # 既存ファイルを削除してビルド済みSPAをコピー
  find "$work_dir" -mindepth 1 -maxdepth 1 -not -name '.git' -exec rm -rf {} +
  cp -r "${spa_dist}/." "$work_dir/"

  # ベースパスとリポジトリ情報を注入
  local owner
  owner=$(get_repo_nwo | cut -d/ -f1)
  for f in "${work_dir}/index.html" "${work_dir}/404.html"; do
    if [ -f "$f" ]; then
      sed_inplace "s|__AT_BASE_PATH__ = '/'|__AT_BASE_PATH__ = '/${repo_name}/'|" "$f"
      sed_inplace "s|__AT_REPO_OWNER__ = ''|__AT_REPO_OWNER__ = '${owner}'|" "$f"
      sed_inplace "s|__AT_REPO_NAME__ = ''|__AT_REPO_NAME__ = '${repo_name}'|" "$f"
    fi
  done

  # .nojekyll を作成
  touch "${work_dir}/.nojekyll"

  git -C "$work_dir" config user.name "$(git config user.name || echo 'gh-extension')"
  git -C "$work_dir" config user.email "$(git config user.email || echo 'gh-extension@users.noreply.github.com')"
  git -C "$work_dir" add -A

  if git -C "$work_dir" diff --cached --quiet 2>/dev/null; then
    ok "SPA に変更はありません"
  else
    git -C "$work_dir" commit -m "Deploy SPA to GitHub Pages (v${VERSION})" >/dev/null
    if git -C "$work_dir" push origin gh-pages; then
      ok "SPA を gh-pages にデプロイしました"
    else
      warn "gh-pages へのプッシュに失敗しました。"
      rm -rf "$work_dir"
      return 1
    fi
  fi

  rm -rf "$work_dir"
  return 0
}

# Agent Skill（Claude Code 等の AI エージェント向けの手順書）の配置先と配布元
SKILL_PATH=".claude/skills/architecture-tracker/SKILL.md"
SKILL_SRC="${DIST_DIR}/${SKILL_PATH}"
# 配置した SKILL.md の末尾に、配置時の内容のハッシュを記録する行。
# 現在の内容のハッシュと一致すれば未編集とみなし、update で自動的に最新版へ更新する
SKILL_HASH_PREFIX="<!-- architecture-tracker-skill-hash: "
SKILL_HASH_SUFFIX=" 未編集なら gh architecture-tracker update で自動更新されます -->"

# ハッシュ行を除いた本文のハッシュ。改行コード（CRLF / LF）の違いは無視する
skill_body_hash() {
  tr -d '\r' < "$1" | sed "/^${SKILL_HASH_PREFIX}[0-9a-f]* /d" | git hash-object --stdin
}

# SKILL.md に記録されたハッシュ（なければ空）
skill_recorded_hash() {
  tr -d '\r' < "$1" | sed -n "s/^${SKILL_HASH_PREFIX}\([0-9a-f]*\) .*/\1/p" | tail -n 1
}

# 配布版の Agent Skill の本文のハッシュ（配布ファイルがなければ空）
distributed_skill_hash() {
  if [ -f "$SKILL_SRC" ]; then
    skill_body_hash "$SKILL_SRC"
  fi
  # 配布ファイルがなくても、呼び出し元の $(...) が set -e で止まらないようにする
  return 0
}

# Agent Skill を配置する。ユーザーがカスタマイズしている可能性があるため、既存ファイルは
# 未編集（記録したハッシュと一致）の場合か、overwrite=true のときだけ上書きする。
# notify=true のときは、編集済みで上書きしない場合に --update-skill を案内する
# （update では、前回から配布版が更新されたときだけ案内する）。
# 配置・更新してコミット対象にすべき場合のみ 0 を返す（配置しなかった・.gitignore 対象は 1）
install_skill() {
  local root="$1" overwrite="$2" notify="${3:-true}"
  local dest="${root}/${SKILL_PATH}"

  if [ ! -f "$SKILL_SRC" ]; then
    warn "Agent Skill の配布ファイルが見つかりません。gh extension を再インストールしてください。"
    return 1
  fi

  local src_hash
  src_hash=$(skill_body_hash "$SKILL_SRC")

  if [ -f "$dest" ]; then
    local dest_hash
    dest_hash=$(skill_body_hash "$dest")
    if [ "$dest_hash" = "$src_hash" ]; then
      ok "${SKILL_PATH}（最新です）"
      return 1
    fi
    if [ "$overwrite" != true ]; then
      if [ "$(skill_recorded_hash "$dest")" != "$dest_hash" ]; then
        if [ "$notify" = true ]; then
          info "${SKILL_PATH} は編集されているため上書きしません（新しい版があります）"
          info "  最新版に置き換えるには: gh architecture-tracker update --update-skill"
        else
          ok "${SKILL_PATH}（編集済みのため変更しません）"
        fi
        return 1
      fi
      info "${SKILL_PATH} は未編集のため、最新版に更新します"
    fi
  fi

  mkdir -p "$(dirname "$dest")"
  {
    tr -d '\r' < "$SKILL_SRC"
    echo "${SKILL_HASH_PREFIX}${src_hash}${SKILL_HASH_SUFFIX}"
  } > "$dest"
  ok "${SKILL_PATH}"

  # .claude/ を .gitignore しているリポジトリでは git add が失敗するため、コミット対象にしない
  if git -C "$root" check-ignore -q "$SKILL_PATH"; then
    warn "${SKILL_PATH} は .gitignore の対象のため、コミットしません"
    return 1
  fi
  return 0
}

# 現在のブランチを origin にプッシュする（失敗しても警告のみ）
push_current_branch() {
  local branch
  branch=$(git branch --show-current)
  if git push origin "$branch"; then
    ok "プッシュ完了 (${branch})"
  else
    warn "プッシュに失敗しました。手動で 'git push' してください。"
  fi
}

# Agent Skill だけを最新版に置き換えてコミット・プッシュする（update --update-skill でバージョンが同じ場合）
update_skill_only() {
  local root="$1" no_push="$2"

  info "Agent Skill を最新版に更新しています..."
  if ! install_skill "$root" true; then
    return 0
  fi

  if [ "$no_push" = true ]; then
    info "--no-push が指定されたため、コミット・プッシュはスキップします。"
    return 0
  fi

  cd "$root"
  git add "$SKILL_PATH"
  if git diff --cached --quiet -- "$SKILL_PATH"; then
    info "変更はありません。"
    return 0
  fi
  # ステージ済みの他の変更を巻き込まないよう、Agent Skill だけをコミットする
  git commit -m "Update Architecture Tracker Agent Skill (v${VERSION})

Updated via gh-architecture-tracker CLI extension." -- "$SKILL_PATH"
  push_current_branch
}

# --- Commands ---

cmd_init() {
  local no_push=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-push) no_push=true; shift ;;
      --help|-h) usage_init; exit 0 ;;
      *) error "不明なオプション: $1"; usage_init; exit 1 ;;
    esac
  done

  require_git_repo
  require_default_branch
  require_dist

  check_latest_version

  require_app_installed

  local root
  root=$(get_repo_root)
  local repo_name
  repo_name=$(get_repo_name)

  info "Architecture Tracker をセットアップします (v${VERSION})"
  echo ""

  # 競合チェック
  if [ -f "${root}/.github/workflows/architecture-tracker.yml" ]; then
    warn "以下のファイルが既に存在します:"
    echo "  - .github/workflows/architecture-tracker.yml"
    if ! confirm "上書きしますか？"; then
      info "中止しました。'gh architecture-tracker update' で更新できます。"
      exit 0
    fi
  fi

  # ファイルコピー
  info "ファイルをコピーしています..."

  # .github/workflows/
  mkdir -p "${root}/.github/workflows"
  cp "${DIST_DIR}/.github/workflows/architecture-tracker.yml" "${root}/.github/workflows/"
  cp "${DIST_DIR}/.github/workflows/impact-analysis.yml" "${root}/.github/workflows/"
  cp "${DIST_DIR}/.github/workflows/catch-up.yml" "${root}/.github/workflows/"
  cp "${DIST_DIR}/.github/workflows/insights-analysis.yml" "${root}/.github/workflows/"
  cp "${DIST_DIR}/.github/workflows/visualize-impact.yml" "${root}/.github/workflows/"
  ok ".github/workflows/architecture-tracker.yml, impact-analysis.yml, catch-up.yml, insights-analysis.yml, visualize-impact.yml"

  # 旧バージョンの init ワークフローが残っている場合は削除
  if [ -f "${root}/.github/workflows/architecture-tracker-init.yml" ]; then
    rm "${root}/.github/workflows/architecture-tracker-init.yml"
    info "不要になった architecture-tracker-init.yml を削除しました"
  fi

  # .github/actions/
  local actions=("shared" "track-architecture" "extract-components" "record-mapping" "generate-mermaid" "catch-up-mapping" "deploy-spa" "detect-model-changes" "bump-model-version" "analyze-impact" "catch-up-bulk" "insights-analysis" "close-tracking-issue")
  local action_count=0
  for action in "${actions[@]}"; do
    if [ -d "${DIST_DIR}/.github/actions/${action}" ]; then
      mkdir -p "${root}/.github/actions/${action}"
      cp -r "${DIST_DIR}/.github/actions/${action}/." "${root}/.github/actions/${action}/"
      action_count=$((action_count + 1))
    fi
  done
  ok ".github/actions/ (${action_count}ディレクトリ)"

  # Agent Skill（既存ファイルは上書きしない）
  local skill_added=false
  if install_skill "$root" false; then
    skill_added=true
  fi

  echo ""
  ok "ファイルの配置が完了しました"

  # Git操作
  if [ "$no_push" = true ]; then
    info "--no-push が指定されたため、コミット・プッシュはスキップします。"
    info "手動でコミット・プッシュしてください。"
  else
    echo ""
    info "変更をコミット・プッシュします..."

    cd "$root"
    local add_targets=(.github/workflows/architecture-tracker.yml .github/workflows/impact-analysis.yml .github/workflows/catch-up.yml .github/workflows/insights-analysis.yml .github/workflows/visualize-impact.yml)
    for action in "${actions[@]}"; do
      if [ -d ".github/actions/${action}" ]; then
        add_targets+=(".github/actions/${action}")
      fi
    done
    # Agent Skill は配置したときだけコミットする（既存ファイルへのユーザーの未コミットの編集を巻き込まない）
    if [ "$skill_added" = true ]; then
      add_targets+=("$SKILL_PATH")
    fi
    git add "${add_targets[@]}"

    # 旧 init ワークフローの削除もステージング
    if git ls-files --error-unmatch .github/workflows/architecture-tracker-init.yml >/dev/null 2>&1; then
      git rm .github/workflows/architecture-tracker-init.yml >/dev/null 2>&1 || true
    fi

    if git diff --cached --quiet; then
      info "変更はありません（既に最新です）。"
    else
      local commit_msg="Add Architecture Tracker (v${VERSION})

Installed via gh-architecture-tracker CLI extension.
- Workflow file for PR tracking
- Composite Actions for component extraction and mapping"
      if [ "$skill_added" = true ]; then
        commit_msg+="
- Agent Skill for AI coding agents"
      fi
      git commit -m "$commit_msg"

      push_current_branch
    fi
  fi

  # データブランチ作成・SPA デプロイ・GitHub Pages 有効化
  if [ "$no_push" = false ]; then
    echo ""

    local repo
    repo=$(get_repo_nwo)

    # データブランチ作成・バージョンマーカー書き込み
    # create_data_branch は新規作成時に VERSION_MARKER を含めるため、
    # 既存ブランチの場合のみ write_version_to_data_branch で更新する
    local remote_url_check
    remote_url_check=$(git remote get-url origin)
    local data_branch_existed=false
    if git ls-remote --heads "$remote_url_check" _architecture-tracker 2>/dev/null | grep -q '_architecture-tracker'; then
      data_branch_existed=true
    fi
    create_data_branch || true
    if [ "$data_branch_existed" = true ]; then
      write_version_to_data_branch "$VERSION" "$(distributed_skill_hash)" || true
    fi

    # プリビルド済みSPAがあれば直接デプロイ
    if [ -d "${DIST_DIR}/spa-dist" ]; then
      deploy_spa_to_ghpages "$root" "$repo_name" || true
    fi

    # GitHub Pages 有効化
    if [ -n "$repo" ]; then
      enable_github_pages "$repo"
    fi

    # ブランチ保護（失敗時は警告のみ）
    if [ -n "$repo" ]; then
      configure_branch_protection "$repo"
    fi
  fi

  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  ok "セットアップ完了！"
  echo ""
  echo "次のステップ:"
  echo "  1. LLM APIキーを設定（オプション）:"
  echo "     リポジトリ Settings → Secrets → ANTHROPIC_API_KEY or OPENAI_API_KEY"
  echo "  2. SPA にアクセス:"
  local pages_owner
  pages_owner=$(gh api user --jq '.login' 2>/dev/null || echo "{owner}")
  echo "     https://${pages_owner}.github.io/${repo_name}/"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
}

cmd_update() {
  local no_push=false update_skill=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --no-push) no_push=true; shift ;;
      --update-skill) update_skill=true; shift ;;
      --help|-h) usage_update; exit 0 ;;
      *) error "不明なオプション: $1"; usage_update; exit 1 ;;
    esac
  done

  require_git_repo
  require_default_branch
  require_dist

  check_latest_version

  local root
  root=$(get_repo_root)
  local repo_name
  repo_name=$(get_repo_name)

  local installed recorded_skill_hash
  installed=$(get_installed_version)
  recorded_skill_hash=$(get_recorded_skill_hash)

  if [ -z "$installed" ]; then
    warn "Architecture Tracker がまだインストールされていません。"
    info "'gh architecture-tracker init' を実行してください。"
    exit 1
  fi

  info "現在のバージョン: ${installed}"
  info "最新のバージョン: ${VERSION}"

  if [ "$installed" = "$VERSION" ]; then
    ok "既に最新バージョンです。"
    if [ "$update_skill" = true ]; then
      # バージョンが同じでも、カスタマイズした Agent Skill を配布版に戻せるようにする
      update_skill_only "$root" "$no_push"
    fi
    exit 0
  fi

  if ! confirm "v${installed} → v${VERSION} に更新しますか？"; then
    info "中止しました。"
    exit 0
  fi

  info "ファイルを更新しています..."

  # ワークフロー
  cp "${DIST_DIR}/.github/workflows/architecture-tracker.yml" "${root}/.github/workflows/"
  cp "${DIST_DIR}/.github/workflows/impact-analysis.yml" "${root}/.github/workflows/"
  cp "${DIST_DIR}/.github/workflows/catch-up.yml" "${root}/.github/workflows/"
  cp "${DIST_DIR}/.github/workflows/insights-analysis.yml" "${root}/.github/workflows/"
  cp "${DIST_DIR}/.github/workflows/visualize-impact.yml" "${root}/.github/workflows/"
  ok ".github/workflows/architecture-tracker.yml, impact-analysis.yml, catch-up.yml, insights-analysis.yml, visualize-impact.yml"

  # 旧バージョンの init ワークフローが残っている場合は削除
  if [ -f "${root}/.github/workflows/architecture-tracker-init.yml" ]; then
    rm "${root}/.github/workflows/architecture-tracker-init.yml"
    info "不要になった architecture-tracker-init.yml を削除しました"
  fi

  # Composite Actions
  local actions=("shared" "track-architecture" "extract-components" "record-mapping" "generate-mermaid" "catch-up-mapping" "deploy-spa" "detect-model-changes" "bump-model-version" "analyze-impact" "catch-up-bulk" "insights-analysis" "close-tracking-issue")
  for action in "${actions[@]}"; do
    if [ -d "${DIST_DIR}/.github/actions/${action}" ]; then
      mkdir -p "${root}/.github/actions/${action}"
      cp -r "${DIST_DIR}/.github/actions/${action}/." "${root}/.github/actions/${action}/"
    fi
  done
  ok ".github/actions/"

  # Agent Skill。編集済みのファイルは --update-skill のときだけ上書きする。
  # データブランチの記録（前回配布していた版）と比べ、配布版が更新されたときだけ案内を表示する。
  # 未配置の場合:
  #   - 記録なし（まだ一度も案内していない）→ 確認してから配置する
  #   - 記録あり（ユーザーが断った・削除した）→ 確認しない。配布版が更新されていれば案内だけ表示する
  local skill_added=false install=false skill_updated=true
  if [ -n "$recorded_skill_hash" ] && [ "$recorded_skill_hash" = "$(distributed_skill_hash)" ]; then
    skill_updated=false
  fi
  if [ "$update_skill" = true ] || [ -f "${root}/${SKILL_PATH}" ]; then
    install=true
  elif [ -z "$recorded_skill_hash" ]; then
    if confirm "AIエージェント向けの Agent Skill（${SKILL_PATH}）を配置しますか？"; then
      install=true
    else
      info "Agent Skill は配置しません。今後は確認しません（Agent Skill が更新されたときは案内します）"
      info "  配置するには: gh architecture-tracker update --update-skill"
    fi
  elif [ "$skill_updated" = true ]; then
    info "Agent Skill が更新されています（このリポジトリには配置されていません）"
    info "  配置するには: gh architecture-tracker update --update-skill"
  fi
  if [ "$install" = true ] && install_skill "$root" "$update_skill" "$skill_updated"; then
    skill_added=true
  fi

  if [ "$no_push" = true ]; then
    info "--no-push が指定されたため、コミット・プッシュはスキップします。"
  else
    cd "$root"
    local add_targets=(.github/workflows/architecture-tracker.yml .github/workflows/impact-analysis.yml .github/workflows/catch-up.yml .github/workflows/insights-analysis.yml .github/workflows/visualize-impact.yml)
    for action in "${actions[@]}"; do
      if [ -d ".github/actions/${action}" ]; then
        add_targets+=(".github/actions/${action}")
      fi
    done
    # Agent Skill は配置・更新したときだけコミットする（既存ファイルへのユーザーの未コミットの編集を巻き込まない）
    if [ "$skill_added" = true ]; then
      add_targets+=("$SKILL_PATH")
    fi
    git add "${add_targets[@]}"

    # 旧 init ワークフローの削除もステージング
    if git ls-files --error-unmatch .github/workflows/architecture-tracker-init.yml >/dev/null 2>&1; then
      git rm .github/workflows/architecture-tracker-init.yml >/dev/null 2>&1 || true
    fi

    if git diff --cached --quiet; then
      info "変更はありません。"
    else
      git commit -m "Update Architecture Tracker to v${VERSION}

Updated via gh-architecture-tracker CLI extension."

      push_current_branch
    fi
  fi

  # バージョンマーカーを _architecture-tracker ブランチに書き込む
  if [ "$no_push" = false ]; then
    local remote_url_check
    remote_url_check=$(git remote get-url origin)
    local data_branch_existed=false
    if git ls-remote --heads "$remote_url_check" _architecture-tracker 2>/dev/null | grep -q '_architecture-tracker'; then
      data_branch_existed=true
    fi
    create_data_branch || true
    if [ "$data_branch_existed" = true ]; then
      write_version_to_data_branch "$VERSION" "$(distributed_skill_hash)" || true
    fi
  fi

  echo ""
  ok "v${VERSION} への更新が完了しました"

  # プリビルド済みSPAがあれば直接デプロイ
  if [ -d "${DIST_DIR}/spa-dist" ]; then
    if confirm "SPA を再デプロイしますか？"; then
      deploy_spa_to_ghpages "$root" "$repo_name" || true
    fi
  fi
}

cmd_catch_up() {
  local since="" until_date="" pr_numbers="" source_repo="" batch_size="10" dry_run=false detect_changes=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --since)
        if [[ -z "${2:-}" ]]; then error "--since には日付（YYYY-MM-DD）を指定してください"; exit 1; fi
        since="$2"; shift 2 ;;
      --until)
        if [[ -z "${2:-}" ]]; then error "--until には日付（YYYY-MM-DD）を指定してください"; exit 1; fi
        until_date="$2"; shift 2 ;;
      --pr-numbers)
        if [[ -z "${2:-}" ]]; then error "--pr-numbers にはPR番号（カンマ区切り）を指定してください"; exit 1; fi
        pr_numbers="$2"; shift 2 ;;
      --source)
        if [[ -z "${2:-}" ]]; then error "--source にはリポジトリ（OWNER/REPO）を指定してください"; exit 1; fi
        source_repo="$2"; shift 2 ;;
      --batch-size)
        if [[ -z "${2:-}" ]]; then error "--batch-size には数値を指定してください"; exit 1; fi
        batch_size="$2"; shift 2 ;;
      --dry-run) dry_run=true; shift ;;
      --detect-changes) detect_changes=true; shift ;;
      --help|-h) usage_catch_up; exit 0 ;;
      *) error "不明なオプション: $1"; usage_catch_up; exit 1 ;;
    esac
  done

  # 日付フォーマットのバリデーション
  if [[ -n "$since" ]] && ! [[ "$since" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
    error "--since の日付フォーマットが不正です（YYYY-MM-DD）: $since"
    exit 1
  fi
  if [[ -n "$until_date" ]] && ! [[ "$until_date" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]]; then
    error "--until の日付フォーマットが不正です（YYYY-MM-DD）: $until_date"
    exit 1
  fi

  # PR番号のバリデーション
  if [[ -n "$pr_numbers" ]]; then
    local IFS=','
    for num in $pr_numbers; do
      num=$(echo "$num" | tr -d '[:space:]')
      [[ -z "$num" ]] && continue
      if ! [[ "$num" =~ ^[0-9]+$ ]]; then
        error "--pr-numbers に無効な値が含まれています: '${num}'"
        exit 1
      fi
    done
    unset IFS
  fi

  # バッチサイズのバリデーション
  if ! [[ "$batch_size" =~ ^[0-9]+$ ]] || [[ "$batch_size" -lt 1 ]]; then
    error "--batch-size には1以上の整数を指定してください: $batch_size"
    exit 1
  fi

  # フィルタが1つも指定されていないかチェック
  if [[ -z "$since" ]] && [[ -z "$until_date" ]] && [[ -z "$pr_numbers" ]]; then
    error "フィルタが1つも指定されていません。--since, --until, --pr-numbers のいずれかを指定してください。"
    exit 1
  fi

  # ソースリポジトリのフォーマットバリデーション
  if [[ -n "$source_repo" ]] && ! [[ "$source_repo" =~ ^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$ ]]; then
    error "--source のフォーマットが不正です（OWNER/REPO）: $source_repo"
    exit 1
  fi

  require_git_repo

  # _architecture-tracker ブランチの存在確認
  local remote_url
  remote_url=$(git remote get-url origin)
  if ! git ls-remote --heads "$remote_url" _architecture-tracker 2>/dev/null | grep -q '_architecture-tracker'; then
    error "_architecture-tracker ブランチが存在しません。"
    info "先に 'gh architecture-tracker init' を実行してください。"
    exit 1
  fi

  # リポジトリ情報の取得
  local repo
  repo=$(get_repo_nwo)
  if [[ -z "$repo" ]]; then
    error "リポジトリ情報を取得できませんでした。GitHub リモートが設定されていることを確認してください。"
    exit 1
  fi

  # 対象PRの概算表示
  local target_repo="${source_repo:-${repo}}"

  if [[ -n "$pr_numbers" ]]; then
    local count
    count=$(echo "$pr_numbers" | tr ',' '\n' | wc -l | tr -d '[:space:]')
    info "対象PR: ${count}件（指定PR番号: ${pr_numbers}）"
  else
    info "対象リポジトリ: ${target_repo}"
    [[ -n "$since" ]] && info "開始日: ${since}"
    [[ -n "$until_date" ]] && info "終了日: ${until_date}"
  fi
  info "バッチサイズ: ${batch_size}"
  if [ "$detect_changes" = true ]; then
    info "モード: モデル変更検出あり"
  fi
  if [ "$dry_run" = true ]; then
    info "モード: dry-run（プレビューのみ）"
  fi

  echo ""
  if ! confirm "catch-up を実行しますか？"; then
    info "中止しました。"
    exit 0
  fi

  # ワークフローのトリガー
  local workflow_args=()
  [[ -n "$since" ]] && workflow_args+=(-f "since=${since}")
  [[ -n "$until_date" ]] && workflow_args+=(-f "until=${until_date}")
  [[ -n "$pr_numbers" ]] && workflow_args+=(-f "pr-numbers=${pr_numbers}")
  [[ -n "$source_repo" ]] && workflow_args+=(-f "source-repo=${source_repo}")
  workflow_args+=(-f "batch-size=${batch_size}")
  workflow_args+=(-f "dry-run=${dry_run}")
  workflow_args+=(-f "detect-changes=${detect_changes}")

  info "catch-up ワークフローをトリガーしています..."
  if gh workflow run catch-up.yml "${workflow_args[@]}" --repo "$repo"; then
    ok "ワークフローをトリガーしました"
    echo ""
    info "実行状況は以下で確認できます:"
    echo "  gh run list --workflow=catch-up.yml --repo ${repo} --limit 1"
    echo "  https://github.com/${repo}/actions/workflows/catch-up.yml"
  else
    error "ワークフローのトリガーに失敗しました。"
    echo ""
    echo "考えられる原因:"
    echo "  - catch-up.yml がデフォルトブランチに存在しない"
    echo "  - ワークフローの実行権限がない"
    exit 1
  fi
}

# 読み取り系サブコマンド（components / history）の実体は lib/architecture_query.py。
# データの書き込みは行わない。オプションの解析は Python 側に任せ、ここでは
# ヘルプ表示・実行環境の確認・--repo の補完のみ行う。
find_python() {
  local candidate
  for candidate in python3 python; do
    # Windows の python3 はストアへのエイリアスの場合があるため、実際に起動できるか確かめる。
    # -I（隔離モード）で、作業ディレクトリのモジュールを読み込まないようにする
    if command -v "$candidate" >/dev/null 2>&1 && \
      "$candidate" -I -c 'import sys; sys.exit(0 if sys.version_info >= (3, 8) else 1)' >/dev/null 2>&1; then
      echo "$candidate"
      return 0
    fi
  done
  return 1
}

run_query() {
  local subcommand="$1"
  shift

  local has_repo=false arg
  for arg in "$@"; do
    case "$arg" in
      --help|-h) "usage_${subcommand}"; exit 0 ;;
      --repo|--repo=*) has_repo=true ;;
    esac
  done

  local python
  if ! python=$(find_python); then
    error "Python 3.8 以上が見つかりません。インストールしてから再度実行してください。"
    exit 1
  fi
  # PyYAML の有無は Python 側で確認する。ここで `python -c 'import yaml'` とすると、
  # 作業ディレクトリが sys.path の先頭に入り、そこにある yaml.py が実行されてしまう

  local repo_args=()
  if [ "$has_repo" = false ]; then
    require_git_repo
    local repo
    repo=$(get_repo_nwo)
    if [ -z "$repo" ]; then
      error "リポジトリ情報を取得できませんでした。--repo OWNER/REPO を指定してください。"
      exit 1
    fi
    repo_args=(--repo "$repo")
  fi

  "$python" "${SCRIPT_DIR}/lib/architecture_query.py" "$subcommand" ${repo_args[@]+"${repo_args[@]}"} "$@"
}

cmd_version() {
  echo "gh-architecture-tracker v${VERSION}"

  local installed
  installed=$(get_installed_version 2>/dev/null || echo "")
  if [ -n "$installed" ]; then
    echo "インストール済みバージョン: v${installed}"
    if [ "$installed" != "$VERSION" ]; then
      warn "更新があります。'gh architecture-tracker update' で更新できます。"
    fi
  fi
}

