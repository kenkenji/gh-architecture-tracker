  --dry-run          プレビューのみ（記録しない）
  --detect-changes   モデル変更検出を有効にする（auto_approve: true が必要）
  -h, --help         このヘルプを表示
EOF
}

usage_components() {
  cat <<EOF
gh architecture-tracker components — 現在のアーキテクチャモデル（コンポーネント一覧）を表示する

使い方:
  gh architecture-tracker components [options]

  _architecture-tracker ブランチの components.yaml を読み取り、
  コンポーネントごとの紐付きPR数とあわせて表示します（読み取り専用）。

オプション:
  --json             JSON で出力する（コンポーネント間の関係も含む）
  --repo OWNER/REPO  対象リポジトリ（省略時はカレントディレクトリの origin）
  -h, --help         このヘルプを表示
EOF
}

usage_history() {
  cat <<EOF
gh architecture-tracker history — コンポーネントの変更履歴を表示する

使い方:
  gh architecture-tracker history --component ID [options]

  mappings.json から、指定したコンポーネントに紐付いたPRを新しい順に表示します（読み取り専用）。

オプション:
  --component ID     対象コンポーネントのID（必須）
  --limit N          表示する件数の上限（デフォルト: すべて）
  --json             JSON で出力する
  --repo OWNER/REPO  対象リポジトリ（省略時はカレントディレクトリの origin）
  -h, --help         このヘルプを表示
EOF
}

# --- Main ---

case "${1:-}" in
  init)     shift; cmd_init "$@" ;;
  update)   shift; cmd_update "$@" ;;
  catch-up) shift; cmd_catch_up "$@" ;;
  components|history) cmd="$1"; shift; run_query "$cmd" "$@" ;;
  version)  cmd_version ;;
  --help|-h) usage ;;
  "") usage ;;
  *) error "不明なコマンド: $1"; usage; exit 1 ;;
esac
